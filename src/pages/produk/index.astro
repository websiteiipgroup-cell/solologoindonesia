---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProdukCard from '../../components/ProdukCard.astro';
import { kategoriInfo } from '../../data/kategori';
import site from '../../data/site.json';
const produk = (await getCollection('produk')).sort((a, b) => a.data.nama.localeCompare(b.data.nama));
---
<Base title="Produk" description="Katalog herbisida, insektisida, dan fungisida Solo Logo Indonesia.">
  <section class="page-head"><div class="wrap">
    <h1>{site.produk_judul}</h1>
    <p>{site.produk_intro}</p>
  </div></section>
  <section class="section"><div class="wrap">
    <nav class="kat-nav" aria-label="Kategori produk">
      {Object.entries(kategoriInfo).map(([nama, k]) => <a href={`#${k.slug}`}>{nama}</a>)}
    </nav>
    {Object.entries(kategoriInfo).map(([nama, k]) => {
      const list = produk.filter((p) => p.data.kategori === nama);
      return list.length > 0 && (
        <div class="kat-blok">
          <h2 id={k.slug}>{nama}</h2>
          <p class="muted" style="margin:-8px 0 24px">{k.desc}</p>
          <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(210px,1fr))">
            {list.map((p) => <ProdukCard p={p} />)}
          </div>
        </div>
      );
    })}
  </div></section>
</Base>
